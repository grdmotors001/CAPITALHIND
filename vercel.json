{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "backend/api/**/*.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/lib/**",
          "backend/api/**"
        ]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/grd/(.*)",
      "dest": "/backend/api/grd.js?path=$1"
    },
    {
      "src": "/api/grd",
      "dest": "/backend/api/grd.js"
    },
    {
      "src": "/api/grd-submit-loan",
      "dest": "/backend/api/grd-submit-loan.js"
    },
    {
      "src": "/api/dealer/grd-submit-loan",
      "dest": "/backend/api/dealer.js?path=grd-submit-loan"
    },
    {
      "src": "/admin/react-login\\.php",
      "dest": "/backend/api/admin.js?path=login"
    },
    {
      "src": "/api/admin/react-login\\.php",
      "dest": "/backend/api/admin.js?path=login"
    },
    {
      "src": "/api/admin/(.*)",
      "dest": "/backend/api/admin.js?path=$1"
    },
    {
      "src": "/api/collection/(.*)",
      "dest": "/backend/api/collection.js?path=$1"
    },
    {
      "src": "/api/customer/(.*)",
      "dest": "/backend/api/customer.js?path=$1"
    },
    {
      "src": "/api/dealer/(.*)",
      "dest": "/backend/api/dealer.js?path=$1"
    },
    {
      "src": "/api/do/(.*)",
      "dest": "/backend/api/do.js?path=$1"
    },
    {
      "src": "/api/field-executive/(.*)",
      "dest": "/backend/api/field-executive.js?path=$1"
    },
    {
      "src": "/api/team-leader/(.*)",
      "dest": "/backend/api/team-leader.js?path=$1"
    },
    {
      "src": "/api/tele-caller/(.*)",
      "dest": "/backend/api/tele-caller.js?path=$1"
    },
    {
      "src": "/api/users/(.*)",
      "dest": "/backend/api/users.js?path=$1"
    },
    {
      "src": "/api/staff/(.*)",
      "dest": "/backend/api/staff.js?path=$1"
    },
    {
      "src": "/api/workflow/available-loans",
      "dest": "/backend/api/workflow/available-loans.js"
    },
    {
      "src": "/api/workflow/deliveries",
      "dest": "/backend/api/workflow/deliveries.js"
    },
    {
      "src": "/api/workflow/sales",
      "dest": "/backend/api/workflow/sales.js"
    },
    {
      "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|json|txt|map|webmanifest))",
      "dest": "/frontend/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}
